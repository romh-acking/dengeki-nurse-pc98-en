     (/ (nop@))
     (/ (nop@))
     (/ (nop@))
     (/ (nop@))
     (/ (nop@))
     (/ (nop@))))))

; 	Text continues here...

 (seg (? (= T 0) (= O 0))						; Think
   (proc 18)
   (text-color 7)
   (str "No good, my brain just isn't functional... I don't")
