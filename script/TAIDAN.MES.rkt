  (text-frame 13 50 71 361)
  (proc 10)
  (str "Hi everyone, it's me, Minami!!")
  (proc 15)
  (proc 11)
  (str "Good evening, Mao here!")
  (proc 15)
  (text-color 11) ; The original script uses color 4, but I think pink works better for the two speaking together
