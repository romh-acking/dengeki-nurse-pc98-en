  (text 'br)
  (text "　　　　　　　　　　　　　　　　　　") (str "The End" 'br)
  (text 'br)
  (text "ＰＳ") (str ". I had to cut a lot due to space" 'br)
  (text "　　　") (str "limitations. Maybe I'll post" 'br)
  (text "　　　") (str "the full version and after-party" 'br)
  (text "　　　") (str "diary online.")
  (proc 16)

