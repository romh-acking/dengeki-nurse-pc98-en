; Dengeki Nurse English Translation - NIKKI.MES
; Translated by Geometrizer
; Edited and commented by trentsignia
; -----Description:-----
; The game's development diary, written by the game's scenario writer and game designer Minami Kasai (AKA producer Hironari Tadokoro).
; It covers the game's conception from October 1991 up to the wrap-up of its production on 29th August 1992 (about a month before its September 22nd release).
; --To change for FMT:--
; The FM Towns version adds a bonus development diary from the game's scenario programmer that continues up to November 1992 (a month before its December release).
(mes
 (meta (engine 'ADV) (charset "pc98"))
 (seg*

; 	Process 16 is temporarily modified to accomodate this section's text box.

  (define-proc 16
    (<>
     ((cmd 209) 1 2)
     (text-color 15)
     (exec-mem 34128 0 6 "▽" 37 320 0 0 1)
     ((cmd 209) 0 2)
     (text-frame 10 36 71 331)
     (text-reset 1)))
  (text-frame 0 0 79 399)
  (text-reset 1)

; 	Text begins here... (62 half-width characters)

  (text-frame 20 150 71 331)
  (text-color 15)
  (str "Dengeki Nurse Development Diary" 'br)
  (text 'br)
  (text "　　　　　　　　　　　　　　　") (str "Minami Kasai")
  (proc 16)

  (text-frame 10 36 71 331)
  (text "　　　　　　　　　") (str "October: Late one night..." 'br)
  (text 'br)
  (text "　") (str "I was chatting with illustrator Furumi-chan while we were" 'br)
  (str "doing an all-nighter." 'br)
  (text 'br)
  (str "Furumi:") (text "“") (str "Minami-san, we should make a nurse game!") (text "”" 'br)
  (str "You see, Furumi-chan has a nurse fetish." 'br)
  (text 'br)
  (str "Minami:") (text "“") (str "Yeah, yeah, sure.") (text "”" 'br)
  (str "And with that answer I let it pass.")
  (proc 16)

  (text "　　　　　　　　　　") (str "October: At the office" 'br)
  (text 'br)
  (str "While Furumi-chan was drawing erotic art..." 'br)
  (str "Minami:") (text "“") (str "I thought about that nurse game you mentioned!") (text "”" 'br)
  (str "Furumi-chan's eyes sparkled." 'br)
  (str "Minami:") (text "“") (str "I'm calling it Dengeki Nurse, what do you think?") (text "”" 'br)
  (str "Furumi-chan's pupils shrunk into pinpoints..." 'br)
  (str "Furumi:") (text "“") (str "W-What in the... Huh???") (text "”" 'br)
  (str "Minami:") (text "“") (str "She'll be a nurse commando who fights evil with a" 'br)
  (text "　　　　") (str " syringe bazooka!") (text "”" 'br)
  (str "Furumi:") (text "“") (str "T-That's not the kind of nurse I had in mind!") (text "”" 'br)
  (text 'br)
  (str "With a grumble, Furumi-chan nonetheless said") (text "“") (str "Maybe something" 'br)
  (str "like this?") (text "”") (str "and came up with a rough character sketch.")
  (proc 16)

  (text "　　　　　　　") (str "November: At a planning meeting" 'br)
  (text 'br)
  (text "　") (str "I went to the meeting with the Dengeki Nurse pitch I wrote" 'br)
  (str "in 30 minutes." 'br)
  (text 'br)
  (str "President Ideken (hereafter referred to as the Prez)" 'br)
  (text "　　　") (str ":") (text "“") (str "The hell is this?") (text "”" 'br)
  (str "Minami:") (text "“") (str "Haha! Funny, isn't it?") (text "”" 'br)
  (str "Prez  :") (text "“") (str "There's no way something like this would ever sell!") (text "”")
  (str "Minami:") (text "“") (str "Ahah, well, nurses are popular, you know...") (text "”" 'br)
  (text 'br)
  (str "In the end, it looked like I had to resubmit it... (Cries)")
  (proc 16)

  (text "　　　　　　　　　　") (str "November: At the office" 'br)
  (text 'br)
  (str "The president was exhausted. And just how exhausted, you ask?" 'br)
  (text 'br)
  (text "　") (str "You see, normally he goes to a fashion health parlor in" 'br)
  (str "Takadanobaba every lunch break to get jerked off, and at night")
  (str "he'd hit a soapland in Kabukichi to do it two more times." 'br)
  (text 'br)
  (text "　") (str "But now, he was so tired he only managed a pink salon in" 'br)
  (str "Sugami once every three days." 'br)
  (text 'br)
  (text "　") (str "I didn't know why he was tired, of course, since I don't" 'br)
  (str "read the paper and only watch pro baseball news.")
  (proc 16)

  (text "　　　　　　") (str "November: At another planning meeting" 'br)
  (text 'br)
  (str "The president is exhausted as always." 'br)
  (str "He's spaced out and staring off into the distance and sighing.")
  (text 'br)
  (str "I decided to seize the moment and pitched the project." 'br)
  (str "Before I knew it, Dengeki Nurse was approved.")
  (proc 16)

  (text "　　　　　　　　") (str "December: Around Christmas" 'br)
  (text 'br)
  (text "　") (str "I got the preliminary Nurse character designs from the" 'br)
  (str "graphics team. I really liked Act Mao-chan's design." 'br)
  (text 'br)
  (str "In my heart I knew,") (text "“") (str "Yes, he will be the one to draw her!") (text "”")
  (proc 16)

  (text "　　　　　　　　　") (str "December: Around New Year's" 'br)
  (text 'br)
  (text "　") (str "The president is busy with all kinds of stuff, and I would" 'br)
  (str "be loathe to trouble the president." 'br)
  (text 'br)
  (text "　") (str "So, to lighten the president's workload, I just went ahead" 'br)
  (str "and assigned staff to Dengeki Nurse myself. For some reason, I")
  (str "picked all the nerds...")
  (proc 16)

  (text "　　　　　　　　　　") (str "January: At the office" 'br)
  (text 'br)
  (str "I had a fierce argument with Mao-chan." 'br)
  (text 'br)
  (str "Mao:") (text "“") (str "Minami-san, your ideas are way too vulgar!") (text "”" 'br)
  (text 'br)
  (str "I was devasated that a young guy would say that to me..." 'br)
  (proc 16)

  (text "　") (str " February (It's a leap year, so there was an extra day)" 'br)
  (text 'br)
  (str "Sotsugyou Shashin is all done!" 'br)
  (str "Now I can concentrate on Dengeki Nurse!!" 'br)
  (text 'br)
  (str "Prez:") (text "“") (str "Sorry, the scenario writer for Yumeji has vanished...") (text "”" 'br)
  (proc 16)

  (text "　　　　　　　　　　") (str "March: At the office" 'br)
  (text 'br)
  (text "　") (str "Mao-chan told me the transformation illustrations were" 'br)
  (str "complete." 'br)
  (str "I looked at them and was shocked! There were 40 frames..." 'br)
  (text 'br)
  (text "　") (str "There was no way I could handle something like this..." 'br)
  (str "Having low blood pressure, I nearly fainted on the spot." 'br)
  (text 'br)
  (str "Mao:") (text "“") (str "Come on, this'll be fine...") (text "”" 'br)
  (text 'br)
  (str "For a graphic designer, Mao-chan is highly educated." 'br)
  (text "　") (str "Burdened by my own academic insecurities, I accepted the" 'br)
  (str "drawings.")
  (proc 16)

  (text "　　　　　") (str "April: In the scary programming room..." 'br)
  (text 'br)
  (str "I delivered the transformation images to programmer Kuni-chan.")
  (text 'br)
  (text "　") (str "While avoiding eye contact, I handed over the disk and made" 'br)
  (str "a break for it." 'br)
  (text 'br)
  (text "　") (str "As I closed the door behind me, I heard Kuni-chan let out " 'br)
  (str "his scream...")
  (proc 16)

  (text "　　　　　　　　　　") (str " April: At the office" 'br)
  (text 'br)
  (text "　") (str "With the transformation sequence complete, we moved on to" 'br)
  (str "the battle graphics." 'br)
  (text 'br)
  (text "　") (str "As the graphic designer Suetake-kun was drawing backgrounds" 'br)
  (str "for the enemies..." 'br)
  (text 'br)
  (str "Minami :") (text "“") (str "Huh? Weren't we gonna do the same black backgrounds" 'br)
  (text "　　　　　") (str "for everyone?") (text "”" 'br)
  (str "Suetake:") (text "“") (str "Nah, it'd be more fun if they were different.") (text "”" 'br)
  (text 'br)
  (str "So the number of illustrations went up by 15...")
  (proc 16)

  (text "　　　　　　　　") (str "April: Spring sure is nice..." 'br)
  (text 'br)
  (text "　") (str "While thinking about the battle system, I realized we had a" 'br)
  (str "major issue." 'br)
  (text 'br)
  (str "The enemies don't strip when you win a battle...that won't do!")
  (text 'br)
  (str "So I decided to order undressing graphics." 'br)
  (text 'br)
  (str "Another 15 illustrations added...")
  (proc 16)

  (text "　　　　　　　　") (str "April: Spring makes me sleepy." 'br)
  (text 'br)
  (str "I met the composer, Kanamori-san." 'br)
  (text 'br)
  (text "　") (str "He's a nice young man with long blond hair. He loves prog" 'br)
  (str "rock, so maybe he was aiming for a Rick Wakeman look, but" 'br)
  (str "honestly I think he just looks like Johnny Winter." 'br)
  (text 'br)
  (text "　") (str "When I told him Dengeki Nurse's theme should have a Ventures")
  (str "style electric guitar sound, he was like,") (text "“") (str "Ha ha ha...") (text "”" 'br)
  (text 'br)
  (text "　") (str "The meeting ended quickly after that, and we instead spent a")
  (str "while excitedly discussing Novela.")
  (proc 16)

  (text "　　　　　　　") (str "May: Transformation complete!!!" 'br)
  (text 'br)
  (str "Kuni-chan presented the finished transformation sequence." 'br)
  (text 'br)
  (text "　") (str "Amazing! Incredible! Moving! I was so overwhelmed I watched" 'br)
  (str "it all day and showed it off to everyone who wandered by." 'br)
  (str "While I was at it, I even sent it off to a magazine." 'br)
  (text 'br)
  (str "Kuni-chan is a genius!" 'br)
  (text 'br)
  (text "　") (str "I told Kuni-chan I'd devote my body and soul to him, but he" 'br)
  (str "turned me down." 'br)
  (proc 16)

  (text "　　　　　　　　　　　") (str "May: At the office" 'br)
  (text 'br)
  (text "　") (str "The president was delighted to see that the transformation" 'br)
  (str "sequence was complete." 'br)
  (text 'br)
  (text "　") (str "Even though he was insisting") (text "“") (str "It won't sell!") (text "”") (str "up until now," 'br)
  (str "he changed his tune quickly! As expected of the president!" 'br)
  (text 'br)
  (text "　") (str "Anyway, the whole company was on board to support the" 'br)
  (str "project. Thank goodness... Thank goodness!")
  (proc 16)

  (text "　　　　　　　　　　　") (str " June: LOGiN attacks!" 'br)
  (text 'br)
  (str "LOGiN Magazine visited for an interview." 'br)
  (text 'br)
  (str "I was at home sick with a cold..." 'br)
  (str "If I'd known, I wouldn't have stayed at home..." 'br)
  (text 'br)
  (str "Producer Tadokoro-san didn't tell anyone beforehand." 'br)
  (text 'br)
  (text "　") (str "He got complaints like") (text "“") (str "I would've gotten a haircut if you" 'br)
  (str "told me!") (text "”") (str "and") (text "“") (str "I'd have worn nicer clothes!") (text "”") (str "and basically got")
  (str "yelled at by everyone." 'br)
  (text 'br)
  (str "Serves him right!!")
  (proc 16)

  (text "　　　") (str " A small tip for the LOGiN editor-in-chief:" 'br)
  (text 'br)
  (text "　") (str "I heard that Davey Hidaka, who was supposed to interview" 'br)
  (str "us, got sucked into playing Dengeki Combat for over an hour" 'br)
  (str "instead. (Just something I heard...)")
  (proc 16)

  (text "　　　") (str " Another tip for the LOGiN editor-in-chief:" 'br)
  (text 'br)
  (text "　") (str "Our sales team recieved LOGiN T-shirts") (text "“") (str "for the staff that" 'br)
  (str "was pulling all-nighters,") (text "”") (str "but they divided them amongst" 'br)
  (str "themselves and not a single one reached the development team!" 'br)
  (text 'br)
  (text "　") (str "Next time you give out T-shirts, make sure you hand them" 'br)
  (str "directly to the devs!")
  (proc 16)

  (text "　　　　　　　　　　　") (str " June: At the office" 'br)
  (text 'br)
  (text "　") (str "I finished writing Yumeji, subbing for the missing scenario" 'br)
  (str "writer." 'br)
  (text 'br)
  (text "　") (str "Ugh... Literature is hard... But now I can finally focus on" 'br)
  (str "Dengeki Nurse!" 'br)
  (text 'br)
  (str "Prez  :") (text "“") (str "Sotsugyou Shashin did well! I want a similar game by" 'br)
  (text "　　　　") (str " October, I'm sure you can do it for me at a stroke.") (text "”")
  (str "Minami:") (text "“") (str "You want me to stroke it for you, out in the open!?") (text "”")
  (text 'br)
  (str "(Kera Kera Boshi will be out on October 30th!)")
  (proc 16)

  (text "　　　　　　　　　") (str " July: Hell approaches..." 'br)
  (text 'br)
  (text "　") (str "I can already see the Can Can Bunny Premiere team in the" 'br)
  (str "depths of hell... It's supposed to ship July 30th and they're" 'br)
  (str "still not done." 'br)
  (text 'br)
  (str "...Seeing the misfortune of others is fun.")
  (proc 16)

  (text "　　　　　　　　　") (str "August: Right before hell" 'br)
  (text 'br)
  (text "　") (str "Producer Tadokoro declared no days off in August, and took" 'br)
  (str "everyone to a beer garden." 'br)
  (text 'br)
  (str "It turned out to be a beer garden where women were doing sumo!")
  (text 'br)
  (text "　") (str "Mao-chan and Suetake-kun watched, entranced. Then the two of")
  (str "them vanished into the Shinjuku night..." 'br)
  (text 'br)
  (str "The next day, Matsumoto-kun, who didn't go, was sulking.")
  (proc 16)

  (text "　　　") (str " August: While the world was on Obon vacation..." 'br)
  (text 'br)
  (str "Music producer Akira-san showed up with a DAT tape!" 'br)
  (str "The CD recording was finished!" 'br)
  (text 'br)
  (str "Unable to resist, we listened immediately." 'br)
  (str "Oh, nice! It's sounding pretty good!" 'br)
  (proc 16)

  (text "　　　　　　　　") (str " August: In the pits of hell" 'br)
  (text 'br)
  (str "We're debugging all five episodes like crazy." 'br)
  (str "It all falls on Naka-chan, the lead programmer." 'br)
  (str "Osuga    :") (text "“") (str "What the-!?") (text "”" 'br)
  (str "Hirama   : ") (text "“") (str "Nakatani-san, the graphics are all messed up!") (text "”" 'br)
  (str "Hiroki   : ") (text "“") (str "Naka-chan, Naka-chan, what is this? What is" 'br)
  (text "　　　　　　") (str "this?") (text "”" 'br)
  (str "Kobayashi:") (text "“") (str "Ahhh, I broke it again!") (text "”" 'br)
  (str "Sakamoto :") (text "“") (str "This is...hopeless...") (text "”" 'br)
  (str "Aihara   :") (text "“") (str "......") (text "”") (str "(He's a quiet guy)" 'br)
  (str "Naka-chan is totally worn out." 'br)
  (str "Nakatani :") (text "“") (str "Shut up, all of you! Make a list!") (text "”" 'br)
  (str "Watching this, my stomach turned sour...")
  (proc 16)

  (text "　　　　　　") (str "August 29th: Free me from this hell!!" 'br)
  (text 'br)
  (str "And so here I am, writing this dev diary." 'br)
  (text 'br)
  (text "　") (str "Mao is exhausted drawing the manual illustrations. Naka-chan")
  (str "is programming the eye-catch." 'br)
  (text 'br)
  (str "What else is left...?" 'br)
  (text 'br)
  (str "This bonus section... The ending..." 'br)
  (text 'br)
  (text "　") (str "Ahh... Once Dengeki Nurse is done, we'll have to check" 'br)
  (str "ourselves into the hospital!")
  (proc 16)

  (text-frame 20 150 71 331)
; PC98
  (str "Dengeki Nurse Development Diary" 'br)
; FMT
